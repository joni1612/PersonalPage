{
  "name": "personal-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "predev": "npm run images",
    "dev": "vite",
    "build": "node scripts/optimize-images.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:build": "node --test tests/seo-build.test.mjs tests/performance-build.test.mjs tests/hosting.test.mjs tests/deploy-pages.test.mjs",
    "audit:performance": "node scripts/performance.mjs",
    "check": "npm test && npm run build && npm run test:build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.1.0",
    "@fontsource/spectral": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
